<Window x:Class="EdgeShelf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EdgeShelf 设置" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ShowInTaskbar="True" Topmost="True"
        Background="#FF20242E" WindowStyle="None" Icon="pack://application:,,,/App.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="0" CornerRadius="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- 深色滑块样式（水平） -->
        <Style TargetType="Slider">
            <Setter Property="Height" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Background="Transparent">
                            <Track x:Name="PART_Track" Orientation="Horizontal">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{DynamicResource AccentBrush}" Height="4"
                                                        CornerRadius="2" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#FF3A4150" Height="4"
                                                        CornerRadius="2" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="14" Height="14" Fill="{DynamicResource AccentBrush}"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="Black" BorderThickness="1" Background="#FF20242E">
        <StackPanel Margin="18,8,18,16">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="EdgeShelf 设置" FontWeight="SemiBold" FontSize="13"
                           Foreground="#E8FFFFFF" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Width="30" Height="26" Click="TitleClose_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="关闭"
                        Foreground="#DDFFFFFF" VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="5">
                                <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#4DFF4C5C"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

        <TextBlock Text="侧边栏" FontWeight="SemiBold" FontSize="13" Foreground="#E8FFFFFF"/>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="名称" VerticalAlignment="Center" Foreground="#CCFFFFFF" FontSize="12.5"/>
            <TextBox x:Name="NameBox" Grid.Column="1" FontSize="12.5" Padding="4,3"
                     Background="#FF2A2F3B" Foreground="White" BorderBrush="#33FFFFFF"/>
        </Grid>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="停靠边缘" VerticalAlignment="Center" Foreground="#CCFFFFFF" FontSize="12.5"/>
            <ComboBox x:Name="EdgeCombo" Grid.Column="1" FontSize="12.5" SelectionChanged="EdgeCombo_Changed">
                <ComboBoxItem Content="左侧"/>
                <ComboBoxItem Content="右侧"/>
                <ComboBoxItem Content="顶部"/>
                <ComboBoxItem Content="底部"/>
            </ComboBox>
        </Grid>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="拐角模式" VerticalAlignment="Center" Foreground="#CCFFFFFF" FontSize="12.5"/>
            <ComboBox x:Name="CornerCombo" Grid.Column="1" FontSize="12.5">
                <ComboBoxItem Content="无（普通边缘）"/>
                <ComboBoxItem Content="左上角 L 形"/>
                <ComboBoxItem Content="右上角 L 形"/>
                <ComboBoxItem Content="左下角 L 形"/>
                <ComboBoxItem Content="右下角 L 形"/>
            </ComboBox>
        </Grid>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="沿边位置" VerticalAlignment="Center" Foreground="#CCFFFFFF" FontSize="12.5"/>
            <StackPanel Grid.Column="1">
                <Slider x:Name="OffsetSlider" Minimum="0" Maximum="1000" TickFrequency="10" ValueChanged="OffsetSlider_ValueChanged"/>
                <Button Content="重置为居中" HorizontalAlignment="Left" Margin="0,4,0,0" Padding="8,2"
                        FontSize="11.5" Click="ResetOffset_Click" Background="#FF2A2F3B" Foreground="#DDFFFFFF"
                        BorderBrush="#33FFFFFF" BorderThickness="1"/>
            </StackPanel>
        </Grid>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CrossLabel" Text="面板宽度" VerticalAlignment="Center" Foreground="#CCFFFFFF" FontSize="12.5"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Slider x:Name="CrossSlider" Minimum="280" Maximum="520" TickFrequency="10" Width="170"
                        ValueChanged="CrossSlider_ValueChanged"/>
                <TextBox x:Name="CrossBox" Text="340" Width="52" Margin="8,0,0,0" FontSize="12"
                         Background="#FF2A2F3B" Foreground="White" BorderBrush="#33FFFFFF"
                         TextChanged="CrossBox_TextChanged"/>
            </StackPanel>
        </Grid>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="AlongLabel" Text="面板高度" VerticalAlignment="Center" Foreground="#CCFFFFFF" FontSize="12.5"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Slider x:Name="AlongSlider" Minimum="160" Maximum="900" TickFrequency="10" Width="170"
                        ValueChanged="AlongSlider_ValueChanged"/>
                <TextBox x:Name="AlongBox" Text="自动" Width="52" Margin="8,0,0,0" FontSize="12"
                         Background="#FF2A2F3B" Foreground="White" BorderBrush="#33FFFFFF"
                         TextChanged="AlongBox_TextChanged"/>
            </StackPanel>
        </Grid>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="面板透明度" VerticalAlignment="Center" Foreground="#CCFFFFFF" FontSize="12.5"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" TickFrequency="5" Width="170"
                        ValueChanged="OpacitySlider_ValueChanged"/>
                <TextBox x:Name="OpacityBox" Text="92" Width="52" Margin="8,0,0,0" FontSize="12"
                         Background="#FF2A2F3B" Foreground="White" BorderBrush="#33FFFFFF"
                         TextChanged="OpacityBox_TextChanged"/>
            </StackPanel>
        </Grid>

        <CheckBox x:Name="AcrylicCheck" Margin="0,10,0,0" Content="亚克力模糊效果（毛玻璃）" Foreground="#CCFFFFFF" FontSize="12.5"/>
        <CheckBox x:Name="FullSpanCheck" Margin="0,8,0,0" Content="整条边缘都能触发弹出（不局限于窄条区域）"
                  Foreground="#CCFFFFFF" FontSize="12.5"/>
        <CheckBox x:Name="FollowMouseCheck" Margin="0,8,0,0" Content="跟随鼠标所在屏幕显示" Foreground="#CCFFFFFF" FontSize="12.5"
                  Checked="FollowMouse_Changed" Unchecked="FollowMouse_Changed"/>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="固定显示屏幕" VerticalAlignment="Center" Foreground="#CCFFFFFF" FontSize="12.5"/>
            <ComboBox x:Name="MonitorCombo" Grid.Column="1" FontSize="12.5"/>
        </Grid>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="模式" VerticalAlignment="Center" Foreground="#CCFFFFFF" FontSize="12.5"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <RadioButton x:Name="ModeNormalRadio" Content="普（正常）" GroupName="ModeGroup"
                             Foreground="#CCFFFFFF" FontSize="12.5"
                             ToolTip="正常模式：蓝条可见、可拖动，边缘接近触发"/>
                <RadioButton x:Name="ModeTransparentRadio" Content="透（透明）" GroupName="ModeGroup" Margin="14,0,0,0"
                             Foreground="#CCFFFFFF" FontSize="12.5"
                             ToolTip="透明模式：蓝条不可见不可触碰（鼠标掠过），边缘接近仍触发"/>
                <RadioButton x:Name="ModeStealthRadio" Content="无（无痕）" GroupName="ModeGroup" Margin="14,0,0,0"
                             Foreground="#CCFFFFFF" FontSize="12.5"
                             ToolTip="无痕模式：蓝条不可见不可触碰，边缘触发关闭，只能托盘 / 快捷键恢复"/>
            </StackPanel>
        </Grid>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="主题色" VerticalAlignment="Center" Foreground="#CCFFFFFF" FontSize="12.5"/>
            <WrapPanel x:Name="AccentPanel" Grid.Column="1"/>
        </Grid>

        <Separator Margin="0,14,0,10" Background="#33FFFFFF"/>

        <TextBlock Text="全局" FontWeight="SemiBold" FontSize="13" Foreground="#E8FFFFFF"/>

        <CheckBox x:Name="AutoStartCheck" Margin="0,10,0,0" Content="开机自启（后台常驻）" Foreground="#CCFFFFFF" FontSize="12.5"/>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="全局快捷键" VerticalAlignment="Center" Foreground="#CCFFFFFF" FontSize="12.5"/>
            <StackPanel Grid.Column="1">
                <TextBox x:Name="HotkeyBox" FontSize="12.5" Padding="4,3" IsReadOnly="True"
                         Background="#FF2A2F3B" Foreground="White" BorderBrush="#33FFFFFF"
                         ToolTip="点击后按下组合键（如 Ctrl+Alt+E）；Esc 取消"
                         PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotKeyboardFocus="HotkeyBox_GotFocus"/>
                <CheckBox x:Name="HotkeyEnableCheck" Content="启用（固定 ⇄ 无痕 切换）" Margin="0,4,0,0"
                          Foreground="#CCFFFFFF" FontSize="12"/>
                <TextBlock Text="点击输入框后按 Ctrl / Alt / Shift + 一个字母键" Foreground="#88FFFFFF" FontSize="10.5" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>
        <Button Content="打开数据文件夹（%APPDATA%\EdgeShelf）" Margin="0,10,0,0" HorizontalAlignment="Left"
                Padding="10,5" FontSize="12" Click="OpenDataDir_Click" Background="#FF2A2F3B" Foreground="#DDFFFFFF"
                BorderBrush="#33FFFFFF" BorderThickness="1"/>
        <Button Content="＋ 新建另一个侧边栏" Margin="0,8,0,0" HorizontalAlignment="Left"
                Padding="10,5" FontSize="12" Click="NewSidebar_Click" Background="#FF2A2F3B" Foreground="#DDFFFFFF"
                BorderBrush="#33FFFFFF" BorderThickness="1"/>
        <Button Content="删除当前页签（含其分组）" Margin="0,8,0,0" HorizontalAlignment="Left"
                Padding="10,5" FontSize="12" Click="DeleteSidebar_Click" Foreground="#FF8A8A"
                Background="#33222222" BorderBrush="#44FF8A8A" BorderThickness="1"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Width="76" Height="30" Margin="0,0,10,0" IsCancel="True"
                    Click="Cancel_Click"
                    Background="#FF2A2F3B" Foreground="#DDFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"/>
            <Button Content="保存" Width="76" Height="30" Click="Save_Click" IsDefault="True"
                    Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"/>
        </StackPanel>
        </StackPanel>
    </Border>
</Window>
